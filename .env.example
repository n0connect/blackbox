# Apple Developer Signing Configuration
# Copy this file to .env and fill in your values.

# Your Apple Developer Team ID (found in developer.apple.com or Xcode)
TEAM_ID=XXXXXXXXXX

# Signing identity (usually "Apple Development" for local builds)
SIGN_IDENTITY=Apple Development

# Path to your macOS provisioning profile
# Generate one via Xcode: Create a macOS App project with Keychain Sharing capability and build it.
# The profile will appear under ~/Library/Developer/Xcode/UserData/Provisioning Profiles/
PROVISION_PROFILE=$(HOME)/Library/Developer/Xcode/UserData/Provisioning Profiles/YOUR-PROFILE-UUID.provisionprofile

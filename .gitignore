/sandbox/logs/
/sandbox/*.scb
/sandbox/*.bbx
/sandbox/*.box
/sandbox/*.vault
/sandbox/*.log

# Global Vault Files (prevent accidental commit of sensitive vaults)
*.bbx
*.box
*.vault
.vacuum-*.tmp

# Agent/implementation reminder (not versioned)
